# Copy to `.env.local` for local development. Never commit that file.
#
# Where appointment and academic enquiries are forwarded. Any endpoint that
# accepts a JSON POST works: a Zapier/Make webhook, a Google Apps Script web
# app, a Formspree-compatible endpoint, or your CRM's intake URL.
APPOINTMENT_WEBHOOK_URL=

# Optional: a separate destination for academic registrations. When empty, the
# academic form falls back to APPOINTMENT_WEBHOOK_URL.
ACADEMIC_WEBHOOK_URL=
